# Names only. Copy to .env (git-ignored) and fill in. VITE_* values are bundled into the browser build,
# so ONLY public values may ever be placed here.
VITE_SUPABASE_URL=                  # https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=      # sb_publishable_... (or the legacy anon key). NEVER the secret / service_role key.
